# Copy to .env.local for local development.

# Base URL of the FastAPI backend (see ../backend). No trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: enables the live traffic-flow overlay on the satellite map. Used
# directly from the browser (TomTom's map tiles are designed for client-side
# use) — get a free key at https://developer.tomtom.com. Omit to just show the
# satellite imagery without the live-flow coloring.
NEXT_PUBLIC_TOMTOM_API_KEY=
