# Copy to .env at the repo root. Used by both backend/ and ingestion/.

# Local dev default matches docker-compose.yml (host port 5433, to avoid colliding with
# a locally-installed Postgres on the default 5432). In production, use your Neon/Supabase
# connection string (starts with postgresql+psycopg2://...).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/bengaluru_traffic

# Get a free key at https://developer.tomtom.com (no credit card required).
TOMTOM_API_KEY=

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
